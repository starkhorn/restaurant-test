{
  "name": "restaurant-menu-system",
  "version": "1.0.0",
  "description": "Restaurant Menu & Order Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage": "jest --coverage --coverageReporters=html --coverageReporters=text"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "nodemon": "^3.0.1",
    "nyc": "^17.1.0",
    "supertest": "^7.1.1"
  },
  "keywords": [
    "restaurant",
    "ordering",
    "menu",
    "qr-code"
  ],
  "author": "Restaurant System",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "server.js",
      "!node_modules/**",
      "!coverage/**",
      "!tests/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "html", "lcov"]
  },
  "nyc": {
    "include": [
      "server.js"
    ],
    "exclude": [
      "tests/**",
      "coverage/**",
      "node_modules/**"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "all": true
  }
}
